# Public hostname. Point an A record (or DuckDNS) at the VM's public IP first.
DOMAIN=estora-demo.duckdns.org
# Used by Caddy for ACME expiry notices. Optional.
EMAIL=you@example.com

MYSQL_DATABASE=estora
MYSQL_USER=estora
MYSQL_PASSWORD=replace-with-a-long-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-password
WP_TABLE_PREFIX=wp_

WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=replace-with-a-strong-password
WP_ADMIN_EMAIL=you@example.com

# 1 = seed the 21 demo listings, agents and viewings on first setup.
ESTORA_DEMO=1
