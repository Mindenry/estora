{
  "name": "estora-platform",
  "private": true,
  "version": "1.4.0",
  "description": "ESTORA real estate management platform — test harness",
  "scripts": {
    "test": "bash scripts/test.sh",
    "test:http": "node --test --test-concurrency=1 tests/http/",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.js",
    "screenshots": "node scripts/screenshots.mjs",
    "export:static": "node scripts/export-static.mjs",
    "serve:dist": "node scripts/serve-dist.mjs dist 8090",
    "deploy:netlify": "npx --yes netlify-cli deploy --dir=dist --prod",
    "test:static": "node scripts/check-static.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
